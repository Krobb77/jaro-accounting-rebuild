# Jaro Accounting backend — example environment.
# Copy to .env and fill in real values. Every key here is consumed by
# app/config.py (the docs-as-tests gate asserts no orphaned keys).
# NEVER commit a real .env.

# Explicit mode allowlist: development | staging | production | test
JARO_MODE=development
# Workload identity: web | worker | migrate (must match DB_ROLE)
JARO_WORKLOAD=web
# Database role: jaro_web | jaro_worker | jaro_migrate
DB_ROLE=jaro_web
# sqlite for local dev/test; postgresql+psycopg2://... in production
DATABASE_URL=sqlite:///./jaro_dev.db

# Secrets: NAME xor NAME_FILE (exactly-one-wins). Values shown are placeholders.
SECRET_KEY=
# SECRET_KEY_FILE=/run/secrets/jaro_secret_key
TOTP_KEK=
# TOTP_KEK_FILE=/run/secrets/jaro_totp_kek
# One-shot owner bootstrap secret (consumed by POST /api/v1/admin/bootstrap)
OWNER_INITIAL_PASSWORD=
# OWNER_INITIAL_PASSWORD_FILE=/run/secrets/jaro_owner_initial_password

# Mail gate: exactly "true" or "false". Real sending additionally requires
# MAIL_BACKEND=smtp. Tests and non-prod MUST keep "false".
MAIL_ALLOW_SEND=false
# capture | smtp
MAIL_BACKEND=capture
MAIL_CAPTURE_DIR=/tmp/jaro-mail-capture

# Local-filesystem document storage root (outside the web root). Jared's
# backup story must cover this volume (H6).
STORAGE_DIR=./var/storage

# SMTP (only used when MAIL_BACKEND=smtp AND MAIL_ALLOW_SEND=true)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# SMTP_PASSWORD=  (or SMTP_PASSWORD_FILE via secret binding)
SMTP_USE_TLS=true
SMTP_FROM=Jaro Accounting <jared@jaroaccounting.com>
